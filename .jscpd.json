{
  "threshold": 5,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/coverage/**",
    "**/dist/**",
    "**/build/**",
    "**/*.min.js",
    "**/generated/**",
    "**/types/generated/**",
    "**/.claude/**",
    "**/.ai-context/**",
    "**/specs/**",
    "**/pnpm-lock.yaml",
    "**/*.test.*",
    "**/*.spec.*",
    "**/mocks/**",
    "**/test/**",
    "**/src/app/**/layout.tsx",
    "**/src/app/**/error.tsx",
    "**/src/app/**/global-error.tsx",
    "**/src/app/**/not-found.tsx",
    "**/src/app/**/loading.tsx",
    "**/src/app/**/template.tsx",
    "tests/legacy/**",
    "**/scripts/**",
    "**/tests/**",
    "**/docs/**",
    "**/e2e/**",
    "**/.superpowers/**",
    "**/next.config.ts",
    "**/vitest.config.*",
    "**/playwright.config.ts",
    "**/instrumentation.ts",
    "**/instrumentation-client.ts",
    "**/postcss.config.mjs",
    "**/tailwind.config.*",
    "**/eslint.config.mjs",
    "**/public/mockServiceWorker.js"
  ],
  "format": ["typescript", "tsx", "javascript", "jsx"],
  "absolute": true,
  "gitignore": true
}
